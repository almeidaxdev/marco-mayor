# ------------------------------------------------------------
# Admin login (no database; single administrator)
# ------------------------------------------------------------
ADMIN_USERNAME=
# Generate with: npm run hash-password
ADMIN_PASSWORD_HASH=
# At least 32 characters. Generate with: npm run session-secret
SESSION_SECRET=

# ------------------------------------------------------------
# Content storage
#   local  -> writes content/posts.json and public/posts/ on disk (development)
#   github -> commits to the repository through the GitHub API (production)
# ------------------------------------------------------------
CONTENT_DRIVER=local

# Server-only. Never prefix with NEXT_PUBLIC_.
# Fine-grained token, limited to this repository, permission "Contents: Read and write".
GITHUB_TOKEN=
GITHUB_OWNER=
GITHUB_REPO=
GITHUB_BRANCH=main

# ------------------------------------------------------------
# Public site URL (used for canonical and Open Graph). No trailing slash.
# ------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=
